! Data Block 8: output control
! --------------------------------------------------
!
'output control'

'output of spatial data'
6				 ;number of output times
86400
2592000
5184000
7776000
10368000
12787200


'output of transient data'
1				 ;number of output locations for transient data
10				 ;time steps between outputs
1 

